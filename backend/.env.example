# Application
APP_ENV=development
APP_NAME=Umbrella API
API_PREFIX=/api/v1
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# Infrastructure connections. Credentials must match docker/.env.
DATABASE_URL=postgresql+psycopg://umbrella:CHANGE_ME@127.0.0.1:5432/umbrella
REDIS_URL=redis://:CHANGE_ME@127.0.0.1:6379/0

# Session cookie
SESSION_COOKIE_NAME=umbrella_session
SESSION_IDLE_TTL_SECONDS=86400
SESSION_ABSOLUTE_TTL_SECONDS=604800
RESTRICTED_SESSION_TTL_SECONDS=1800
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Authentication lifetimes
EMAIL_VERIFICATION_TTL_MINUTES=30
PASSWORD_RESET_TTL_MINUTES=30
INVITATION_TTL_HOURS=72
AUDIT_RETENTION_DAYS=365

# Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AUTH_ENCRYPTION_KEY=REPLACE_WITH_A_FERNET_KEY

# SMTP
# Port 587 normally requires SMTP_STARTTLS=true before authentication.
# Local mail-capture servers on port 1025 normally use no credentials and no TLS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@umbrella.local
SMTP_FROM_NAME=Umbrella
SMTP_STARTTLS=false

# Rate limits
LOGIN_RATE_LIMIT=5
LOGIN_RATE_WINDOW_SECONDS=900
PUBLIC_RATE_LIMIT=5
PUBLIC_RATE_WINDOW_SECONDS=3600

# HTTP
REQUEST_ID_HEADER=X-Request-Id
