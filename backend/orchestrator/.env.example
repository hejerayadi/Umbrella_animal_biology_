# Copy this file to .env and keep it next to backend/orchestrator/llm.py.
# Required Azure OpenAI settings.
azure_endpoint=https://<your-resource>.openai.azure.com/
openai_key_azure=REPLACE_WITH_YOUR_AZURE_OPENAI_KEY

# Optional overrides used by the shared LLM wrapper.
AZURE_OPENAI_API_VERSION=2024-12-01-preview
AZURE_OPENAI_DEPLOYMENT=gpt-5.1
