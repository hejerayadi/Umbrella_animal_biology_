# --- LLM backend --------------------------------------------------------
# The llm_client wrapper tries these in order, first-configured wins:
#   1. Groq            (recommended for dev - free, no red tape)
#   2. GitHub Models   (free, requires accepting marketplace terms)
#   3. Azure OpenAI    (repo-wide standard, requires Hajer's resource)

# Option A: Groq (recommended)
# Sign up at https://console.groq.com, generate a key at
# https://console.groq.com/keys — starts with `gsk_`.
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxx
GROQ_MODEL=llama-3.3-70b-versatile

# Option B: GitHub Models
# Generate a classic PAT at https://github.com/settings/tokens
# (no scope required). Must accept marketplace terms at
# https://github.com/marketplace/models first.
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx
GITHUB_MODEL=gpt-4o-mini

# Option C: Azure OpenAI (repo-wide standard)
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
AZURE_OPENAI_API_KEY=<your-azure-openai-key>
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_API_VERSION=2024-08-01-preview

# --- Qdrant (Umbrella project cluster) ---------------------------------
QDRANT_URL=https://<cluster-id>.aws.cloud.qdrant.io:6333
QDRANT_API_KEY=<your-qdrant-api-key>
