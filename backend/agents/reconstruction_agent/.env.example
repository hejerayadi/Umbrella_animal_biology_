# Copy this file to .env in this directory before running the agent.
#
# .env is git-ignored and must never be committed. This .env.example IS
# committed, so keep real secrets out of it - placeholders only.

# --- Application boot ------------------------------------------------------
# development | staging | production | test
# Also decides the default log format and whether /docs is exposed.
APP_ENV=development
APP_NAME=Umbrella Reconstruction Agent
APP_HOST=127.0.0.1
# 8006 is this agent's slot in backend/registry.py. Changing it here alone
# would leave the orchestrator calling the old port.
APP_PORT=8006
APP_RELOAD=false

# --- Logging ---------------------------------------------------------------
LOG_LEVEL=INFO
# pretty = colour-rendered for a terminal, json = one object per line.
# Leave unset to follow APP_ENV (pretty in development, json everywhere else).
LOG_FORMAT=pretty
# Correlation headers. X-Trace-Id is stable for a whole orchestrator run;
# X-Request-Id is unique per HTTP attempt.
REQUEST_ID_HEADER=X-Request-Id
TRACE_ID_HEADER=X-Trace-Id

# --- Agent behaviour -------------------------------------------------------
# Upper bound on plan/act/critique cycles before the graph stops and returns
# whatever evidence it has. Guards against runaway loops and API spend.
RECONSTRUCTION_MAX_ITERATIONS=6
# A candidate below this confidence is never returned as a reconstruction; the
# gap is reported UNRESOLVED instead. Deliberately low, because the deterministic
# score is what separates correct from incorrect - the threshold does not have
# to compensate for a score that cannot.
RECONSTRUCTION_MIN_CONFIDENCE=0.15
# Longest gap (in bases) this agent will attempt to reconstruct.
RECONSTRUCTION_MAX_GAP_LENGTH=5000
# Draft assemblies carry hundreds of N-runs (NW_007907101 has ~500). A run
# commits to the gaps it can finish inside the deadline and reports the rest.
RECONSTRUCTION_MAX_GAPS_PER_RUN=8

# --- Deadline --------------------------------------------------------------
# The whole run is one HTTP call. The orchestrator allows 600 s
# (AGENT_READ_TIMEOUT_SECONDS in backend/orchestrator), so finishing well
# inside that is what keeps a reconstruction from being discarded wholesale.
# On expiry the agent finalises with the evidence it has: gaps still open come
# back UNRESOLVED with reason DEADLINE_EXCEEDED, never a fabricated sequence.
RECONSTRUCTION_DEADLINE_SECONDS=300
# Reserved for scoring, validation, serialisation - subtracted from the budget
# available to tools.
RECONSTRUCTION_FINALIZATION_RESERVE_SECONDS=30
# How the remaining time is apportioned across phases.
RECONSTRUCTION_HOMOLOGY_BUDGET_SECONDS=200
RECONSTRUCTION_ALIGNMENT_BUDGET_SECONDS=40
RECONSTRUCTION_ARBITRATION_BUDGET_SECONDS=30

# --- Tool budgets ----------------------------------------------------------
# Guard rails, not cost control. Reserved BEFORE a concurrent round is
# dispatched, so parallel calls can never overrun the count.
RECONSTRUCTION_MAX_TOOL_CALLS=24
RECONSTRUCTION_MAX_BLAST_CALLS=8
RECONSTRUCTION_MAX_MAFFT_CALLS=8
RECONSTRUCTION_MAX_EVO2_CALLS=4
RECONSTRUCTION_MAX_LLM_CALLS=12


# --- LLM -------------------------------------------------------------------
# azure_openai | none
# "none" disables LLM planning and runs the deterministic fallback plan, which
# is what the test suite uses - the graph must work without a key.
LLM_PROVIDER=azure_openai
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=2048

# --- Azure OpenAI ----------------------------------------------------------
AZURE_OPENAI_BASE_URL=https://YOUR-RESOURCE.cognitiveservices.azure.com
AZURE_OPENAI_DEPLOYMENT=your-deployment-name
AZURE_OPENAI_API_KEY=REPLACE_WITH_YOUR_AZURE_KEY
# Azure pins the wire format by date; a mismatch shows up as a 404 on the
# deployment rather than a version error.
AZURE_OPENAI_API_VERSION=2024-10-21

# --- NVIDIA NIM (Evo 2 genomic foundation model) --------------------------
# Checks a candidate against what Evo 2 expects in context. Called only to
# break a tie between competing candidates, never on every candidate.
# Without a key the Evo 2 tool is simply not registered and the rest works.
# NOTE: NIM exposes /forward (embeddings, no logits) and /generate only - there
# is no scoring endpoint, so plausibility is an agreement check against the
# model's own continuation. NGC lists 'evo2-40b-forward', but that is the
# /forward endpoint of evo2-40b; .../arc/evo2-40b-forward is a 404.
NVIDIA_API_KEY=REPLACE_WITH_YOUR_NVIDIA_KEY
NVIDIA_BASE_URL=https://health.api.nvidia.com/v1/biology/arc/evo2-40b
NVIDIA_MODEL=arc/evo2-40b
NVIDIA_TIMEOUT_SECONDS=120

# --- Homology search -------------------------------------------------------
# A record cannot be evidence about its own unresolved region. Leaving it in
# also makes a ground-truth measurement a lookup of the answer.
HOMOLOGY_EXCLUDE_TARGET_ACCESSION=true

# --- NCBI BLAST URL API ----------------------------------------------------
# The homology search service. NCBI issues API keys for E-utilities only, so
# nothing here is authenticated - NCBI asks for identification and restraint
# instead: a tool and email on every call, one request per 10 s, one poll per
# minute per search.
NCBI_BLAST_BASE_URL=https://blast.ncbi.nlm.nih.gov
NCBI_BLAST_DATABASE=core_nt
# blastn, not megablast. Measured: megablast is a local aligner and splits at
# the gap, returning hits at identity 1.000 of which none span the region.
NCBI_BLAST_PROGRAM=blastn
NCBI_BLAST_MEGABLAST=false
NCBI_BLAST_CONTACT_EMAIL=
# NCBI asks for no more than one request every 10 seconds, and that a single
# search not be polled more than once a minute. Both are honoured; the cost is
# that a fast search is noticed late.
NCBI_BLAST_REQUESTS_PER_SECOND=0.1
NCBI_BLAST_POLL_INTERVAL_SECONDS=60
NCBI_BLAST_POLL_TIMEOUT_SECONDS=600

# --- NCBI ------------------------------------------------------------------
# E-utilities allows 3 requests/second anonymously, 10/second with an API key.
# Also the authority for taxonomy: lineages, ranks, and the vernacular names
# that EMBL-EBI's database labels are resolved against.
NCBI_BASE_URL=https://eutils.ncbi.nlm.nih.gov/entrez/eutils
NCBI_API_KEY=
# NCBI asks that every caller identify itself; used as the tool/email params.
NCBI_TOOL_NAME=umbrella-reconstruction-agent
NCBI_CONTACT_EMAIL=

# --- EMBL-EBI (MAFFT alignment only) --------------------------------------
# Homology search runs at NCBI; alignment stays here because NCBI publishes no
# alignment service and no MAFFT binary is installed in this repository.
# REQUIRED: EMBL-EBI rejects anonymous job submissions, so without this every
# gap that reaches alignment comes back unresolved.
EMBL_EBI_BASE_URL=https://www.ebi.ac.uk/Tools/services/rest
EMBL_EBI_CONTACT_EMAIL=
EMBL_EBI_POLL_INTERVAL_SECONDS=5
EMBL_EBI_POLL_TIMEOUT_SECONDS=280

# --- HTTP ------------------------------------------------------------------
HTTP_TIMEOUT_SECONDS=30
HTTP_MAX_RETRIES=3

# --- Tracing ---------------------------------------------------------------
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=umbrella-reconstruction-agent
