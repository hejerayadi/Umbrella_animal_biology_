# Copy this file to .env inside reconstruction_agent/ before running this agent.
#
# .env is git-ignored and must never be committed. This .env.example IS
# committed, so keep real secrets out of it - placeholders only.

# --- Application boot ------------------------------------------------------
# development | staging | production | test
# Also decides the default log format and whether /docs is exposed.
APP_ENV=development
APP_NAME=Umbrella Reconstruction Agent
APP_HOST=127.0.0.1
# 8006 is this agent's slot in backend/registry.py. Changing it here alone
# would leave the orchestrator calling the old port.
APP_PORT=8006
APP_RELOAD=false

# --- Logging ---------------------------------------------------------------
LOG_LEVEL=INFO
# pretty = rich-rendered colour for a terminal, json = one object per line.
# Leave unset to follow APP_ENV (pretty in development, json everywhere else).
LOG_FORMAT=pretty
# Inbound correlation id header, propagated into every log record.
REQUEST_ID_HEADER=X-Request-ID

# --- Agent behaviour -------------------------------------------------------
# Upper bound on plan/act/critique cycles before the graph stops and returns
# whatever evidence it has. Guards against runaway loops and API spend.
RECONSTRUCTION_MAX_ITERATIONS=6
# A candidate below this confidence is never returned as a reconstruction.
# 0.65 is measured, not guessed: scripts/tune_settings.py sweeps 360 synthetic
# gaps with known answers, and 0.65 is the lowest threshold with zero wrong
# reconstructions accepted. Lower it to trade precision for recall.
RECONSTRUCTION_MIN_CONFIDENCE=0.65
# Longest gap (in bases) this agent will attempt to reconstruct.
RECONSTRUCTION_MAX_GAP_LENGTH=5000

# --- Agent loop budgets ----------------------------------------------------
# Guard rails, not cost control: the orchestrator allows 120 s per HTTP call
# and retries a CONTINUE only three times, so an unbounded loop gets the whole
# run force-failed and every finding discarded.
RECONSTRUCTION_MAX_TOOL_CALLS=12
RECONSTRUCTION_MAX_BLAST_CALLS=4
RECONSTRUCTION_MAX_MAFFT_CALLS=6
RECONSTRUCTION_MAX_LLM_TOKENS=60000

# --- Continuation (slicing across HTTP calls) -----------------------------
# Yield back to the orchestrator before its 120 s read timeout, leaving margin
# for the in-flight tool call to finish and the result to serialise.
AGENT_YIELD_AFTER_SECONDS=90
# Slices the orchestrator grants: the first call plus three CONTINUE retries.
# On the last one the agent returns partial results instead of asking again.
AGENT_MAX_SLICES=4
# The orchestrator's run-wide id. Stable across retries, so it keys the
# checkpoint - unlike X-Request-Id, which is unique per HTTP attempt.
TRACE_ID_HEADER=X-Trace-Id

# --- Checkpoints and run audit --------------------------------------------
# The SAME database the backend uses - see backend/.env DATABASE_URL. One
# database, one schema; the agent's tables are told apart by name.
# Without it the agent still runs, but a CONTINUE cannot resume: every retry
# restarts from nothing and the run then fails after three attempts.
RECONSTRUCTION_DATABASE_URL=postgresql+psycopg://umbrella:CHANGE_ME@127.0.0.1:5432/umbrella

# --- LLM -------------------------------------------------------------------
# azure_foundry | azure_openai | openai | none
# "none" disables LLM planning and runs the deterministic fallback plan.
LLM_PROVIDER=azure_foundry
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=2048

# --- Azure OpenAI / AI Foundry --------------------------------------------
AZURE_OPENAI_BASE_URL=https://YOUR-RESOURCE.cognitiveservices.azure.com
AZURE_OPENAI_DEPLOYMENT=your-deployment-name
AZURE_OPENAI_API_KEY=REPLACE_WITH_YOUR_AZURE_KEY
# Azure pins the wire format by date; a mismatch shows up as a 404 on the
# deployment rather than a version error.
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_FOUNDRY_PROJECT_ENDPOINT=https://YOUR-RESOURCE.services.ai.azure.com/api/projects/your-project

# --- NVIDIA NIM (Evo 2 genomic foundation model) --------------------------
# Checks a candidate reconstruction against what Evo 2 expects in context.
# Without a key the Evo 2 tool is not registered at all.
# NOTE: NGC lists this as 'evo2-40b-forward', but that is the /forward
# endpoint of the evo2-40b model - .../arc/evo2-40b-forward is a 404.
NVIDIA_API_KEY=REPLACE_WITH_YOUR_NVIDIA_KEY
NVIDIA_BASE_URL=https://health.api.nvidia.com/v1/biology/arc/evo2-40b
NVIDIA_MODEL=arc/evo2-40b
NVIDIA_TIMEOUT_SECONDS=120

# --- NCBI ------------------------------------------------------------------
# E-utilities allows 3 requests/second anonymously, 10/second with an API key.
NCBI_BASE_URL=https://eutils.ncbi.nlm.nih.gov/entrez/eutils
NCBI_API_KEY=
# NCBI asks that every caller identify itself; used as the tool/email params.
NCBI_TOOL_NAME=umbrella-reconstruction-agent
NCBI_CONTACT_EMAIL=

# --- EMBL-EBI (BLAST + MAFFT) ---------------------------------------------
# REQUIRED: EMBL-EBI rejects anonymous job submissions. Without this the agent
# still starts and still detects gaps, but every gap comes back unresolved.
EMBL_EBI_BASE_URL=https://www.ebi.ac.uk/Tools/services/rest
EMBL_EBI_CONTACT_EMAIL=
EMBL_EBI_POLL_INTERVAL_SECONDS=5
EMBL_EBI_POLL_TIMEOUT_SECONDS=600

# --- HTTP ------------------------------------------------------------------
HTTP_TIMEOUT_SECONDS=30
HTTP_MAX_RETRIES=3

# --- Tracing ---------------------------------------------------------------
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=umbrella-reconstruction-agent
