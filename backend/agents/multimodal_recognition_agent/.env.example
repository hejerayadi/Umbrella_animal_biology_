# Copy this file to .env inside multimodal_recognition_agent/ before running this agent locally.
#
# .env is git-ignored and must never be committed. This .env.example IS
# committed, so keep real secrets out of it - names and empty placeholders only.
#
# The agent reads these from the PROCESS ENVIRONMENT. It does not load a .env
# file itself: whoever starts the service owns how the environment is populated.

AGENT_NAME=multimodal_recognition_agent
AGENT_MODE=local

# --- Paired image + text validation -------------------------------------
# The image context key is fixed at `recognition_image` and is not configurable.
MAX_IMAGE_BYTES=10485760
MAX_IMAGE_PIXELS=25000000
MIN_IMAGE_WIDTH=64
MIN_IMAGE_HEIGHT=64

# --- BioCLIP-2 -----------------------------------------------------------
# BioCLIP-2 is the official final model. Sprint 2 mocks its execution: no
# package is imported, no weights are downloaded. `mock` is the only accepted
# value and the agent refuses to start with anything else.
BIOCLIP_PROVIDER_MODE=mock
BIOCLIP_MOCK_PROVIDER_VERSION=local-dev-mock-bioclip2-v0
# Must equal QDRANT_EXPECTED_DIMENSION once Chahd confirms it. Left empty, the
# agent uses a local default and says so in every response's provenance.
MOCK_EMBEDDING_DIMENSION=

# --- Retrieval -----------------------------------------------------------
# `mock`  local fixture retriever - development and unit tests ONLY. It does
#         NOT satisfy the Sprint 2 Qdrant deliverable.
# `real`  the Qdrant adapter, which refuses to start until every QDRANT_*
#         contract value below is supplied.
RECOGNITION_RETRIEVAL_MODE=mock

# --- Qdrant collection contract -----------------------------------------
# Every value below belongs to the Sprint 2 Qdrant ingestion owner (Chahd).
# Names are declared here; VALUES belong only in the git-ignored .env.
# Nothing here is guessed - an empty value keeps real retrieval switched off.
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=
QDRANT_VECTOR_NAME=
QDRANT_EXPECTED_DIMENSION=
QDRANT_EXPECTED_DISTANCE=
QDRANT_DATASET_VERSION=
QDRANT_TOP_K_REFERENCES=
QDRANT_TIMEOUT_SECONDS=10

# --- Ranking and confidence ---------------------------------------------
# Workflow test boundaries, not scientific calibration.
RECOGNITION_TOP_K_SPECIES=5
RECOGNITION_MAX_REFERENCES_PER_SPECIES=3
IDENTIFIED_MIN_SCORE=0.75
IDENTIFIED_MIN_MARGIN=0.08
UNCERTAIN_MIN_SCORE=0.45

# --- Taxonomy ------------------------------------------------------------
# GBIF/NCBI/IUCN are mocked in Sprint 2. `mock` is the only accepted value.
TAXONOMY_PROVIDER_MODE=mock

# --- Text analysis -------------------------------------------------------
# Deterministic rules are the first and default path.
TEXT_ANALYZER_MODE=rules

# --- Optional reasoning LLM ----------------------------------------------
# GPT-5 mini is the approved Recognition reasoning model. It is OPTIONAL and
# DISABLED by default: Recognition runs entirely on deterministic rules unless
# this is explicitly switched on, and it falls back to those rules whenever the
# model is missing, slow, or answers off-contract.
#
# A clear intent costs zero calls. Only an ambiguous request may spend one.
RECOGNITION_REASONING_LLM_ENABLED=false
RECOGNITION_LLM_MAX_CALLS_PER_REQUEST=1
RECOGNITION_LLM_TIMEOUT_SECONDS=10
#
# Credentials for the approved deployment. Names only here - VALUES belong in
# the git-ignored .env and nowhere else. Leaving any of them empty keeps the
# adapter on the deterministic path.
AZURE_OPENAI_BASE_URL=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_REASONING_EFFORT=low
AZURE_OPENAI_MAX_OUTPUT_TOKENS=400

# --- Local development aid ----------------------------------------------
# Optional JSON object mapping an image SHA-256 to a fixture vector seed, so a
# known demo image retrieves a known species. Holds hashes only - never image
# data. Use the species_id as the seed to land on that species' cluster centre.
# Example: {"<sha256-of-the-demo-image>":"panthera_leo"}
RECOGNITION_IMAGE_SEED_OVERRIDES=
