# Copy this file to .env inside multimodal_recognition_agent/ before running this agent locally.
#
# .env is git-ignored and must never be committed. This .env.example IS
# committed, so keep real secrets out of it - names and empty placeholders only.
#
# The agent reads these from the PROCESS ENVIRONMENT. It does not load a .env
# file itself: whoever starts the service owns how the environment is populated.
#
# There is deliberately no QDRANT_* section, no vector dimension, no collection
# name and no dataset version. This agent classifies an image into taxonomic
# labels; it runs no vector search, so it has nothing to configure one with and
# reads no such variable.

AGENT_NAME=multimodal_recognition_agent
AGENT_MODE=local

# --- Paired image + text validation -------------------------------------
# Both parts are required: one image AND one non-empty text instruction.
# The image context key is fixed at `recognition_image` and is not configurable.
MAX_IMAGE_BYTES=10485760
MAX_IMAGE_PIXELS=25000000
MIN_IMAGE_WIDTH=64
MIN_IMAGE_HEIGHT=64

# --- BioCLIP-2 species classification -----------------------------------
# BioCLIP-2 is the official final model. It runs REMOTELY on the model authors'
# public Space, so nothing here imports a model package, downloads weights or
# needs a GPU.
#
#   mock    the deterministic fixture-backed test oracle (offline, no network)
#   remote  real BioCLIP-2 inference on the official public Hugging Face Space
#           `imageomics/bioclip-2-demo`. No API key, no model weights and no
#           embedding cache are downloaded; the agent sends one image and the
#           rank `Species` and receives at most five ranked taxonomic labels.
#
# Any other value is refused at startup, listing the legal ones. Neither mode can
# silently become the other: remote mode never falls back to the fixture oracle,
# because fixture predictions served under a production banner would be invented
# biology presented as measurement.
BIOCLIP_PROVIDER_MODE=mock

# Bounded wait for the remote Space, covering queue time plus inference. The
# Space runs on shared CPU hardware, so this is deliberately generous - but it is
# still a hard bound, and there is no retry loop behind it.
RECOGNITION_REMOTE_CLASSIFIER_TIMEOUT_SECONDS=90
BIOCLIP_MOCK_PROVIDER_VERSION=sprint2-mock-bioclip2-classifier-v1

# Optional path to an alternative classification fixture, so a demo can register
# its own image SHA-256 digests without editing the committed test oracle.
# Left empty, fixtures/mock_bioclip_predictions.json is used.
RECOGNITION_CLASSIFICATION_FIXTURE_PATH=

# --- Ranking and confidence ---------------------------------------------
# Workflow test boundaries, not scientific calibration. In Sprint 2 the scores
# they compare are deterministic mock values.
RECOGNITION_TOP_K_SPECIES=5
IDENTIFIED_MIN_SCORE=0.75
IDENTIFIED_MIN_MARGIN=0.08
UNCERTAIN_MIN_SCORE=0.45

# --- Taxonomy ------------------------------------------------------------
# GBIF and NCBI are still fixture-backed. IUCN is out of scope for this agent.
#
#   mock  the committed taxonomy fixture (the only working value)
#   real  reserved for the Phase 4 live GBIF/NCBI adapters. Recognised but NOT
#         yet implemented: selecting it stops the agent at startup rather than
#         returning fixture identifiers as though they had been looked up.
#
# Any other value is refused at startup, listing the legal ones.
TAXONOMY_PROVIDER_MODE=mock

# --- Text analysis -------------------------------------------------------
# Deterministic rules are the first and default path.
TEXT_ANALYZER_MODE=rules

# --- Optional reasoning LLM ----------------------------------------------
# GPT-5 mini is the approved Recognition reasoning model. It is OPTIONAL and
# DISABLED by default: Recognition runs entirely on deterministic rules unless
# this is explicitly switched on, and it falls back to those rules whenever the
# model is missing, slow, or answers off-contract. The whole test suite passes
# with no credentials and no network.
#
# A clear intent costs zero calls. Only an ambiguous request may spend one.
# Which reasoning provider the workflow uses:
#   disabled  no LLM at all - the deterministic path (the code default)
#   fake      FakeGPT5MiniProvider, offline and reproducible (use this for dev/tests)
#   azure     the real GPT-5 mini deployment
RECOGNITION_LLM_PROVIDER_MODE=fake

# Two calls at most, ever: one to plan, one to explain.
#   0        spend no calls at all - the fully deterministic path
#   1        planning only; a failed planner still forfeits the explainer
#   2        the maximum, and the default
# A value above 2 is clamped back to 2 - the workflow has only two roles to
# spend a call on. A negative or non-numeric value is refused at startup rather
# than guessed at.
RECOGNITION_LLM_MAX_CALLS_PER_REQUEST=2

# The ONE timeout that bounds a reasoning call, in seconds. This is the only
# variable that sets it - the adapter reads no timeout of its own. Must be a
# positive, finite number; zero, negative, NaN and infinity are refused at
# startup because each one either removes the bound or fails every call.
RECOGNITION_LLM_TIMEOUT_SECONDS=20
#
# Connection settings for the approved deployment, used only when
# RECOGNITION_LLM_PROVIDER_MODE=azure. NAMES ONLY HERE - the base URL and the
# key are secrets and belong exclusively in the git-ignored .env. Selecting
# azure mode without them fails loudly, naming the missing variables; it never
# falls back to a fake model silently.
AZURE_OPENAI_BASE_URL=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=umbrella-gpt5-mini
AZURE_OPENAI_REASONING_EFFORT=low
AZURE_OPENAI_MAX_OUTPUT_TOKENS=400
