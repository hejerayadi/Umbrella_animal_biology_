# Publication Support subagent (journal / venue recommendation)
#
# Copy to .env in THIS directory and fill in. The .env is git-ignored; this
# file is committed, so placeholders only - never a real key.
#
# Values not set here fall back to the Literature_Agent .env two levels up.

# --- Qdrant (the `journals` collection, ingested from OpenAlex) -------------
# QDRANT_URL is the repo-wide name. CLUSTER_ENDPOINT is still accepted as an
# alias so an older .env in this folder keeps working.
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_JOURNALS_COLLECTION=journals

# --- Azure OpenAI (query interpretation + LLM re-ranking) ------------------
# Endpoint may include /openai/v1. DEPLOYMENT is the deployment name, not the
# model name. Without these the pipeline still retrieves and hybrid-ranks
# journals; only the LLM re-ranking step is skipped.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
