# Retrieval & Knowledge Processing subagent
#
# Copy this file to .env in THIS directory and fill it in. The .env is
# git-ignored; this .env.example is committed, so keep placeholders only -
# never a real key.
#
# Values not set here fall back to the Literature_Agent .env two levels up
# (QDRANT_URL / QDRANT_API_KEY are declared there too), then to the defaults
# in finalagenttt.py.

# --- Qdrant (vector store + semantic cache) ---------------------------------
# Cluster URL, no trailing slash. Required.
QDRANT_URL=
QDRANT_API_KEY=
# Collection holding the indexed articles and syntheses.
QDRANT_COLLECTION=lina_researchPaperArticles
# Must match the embedding model's output dimension (384 for the MiniLM
# models below). Changing it requires re-creating the collection.
QDRANT_VECTOR_SIZE=384

# --- Groq Cloud (query generation, summarization, synthesis) ----------------
GROQ_API_KEY=
GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions
GROQ_MODEL=openai/gpt-oss-20b

# --- Firecrawl (web search + scraping) --------------------------------------
FIRECRAWL_API_KEY=
FIRECRAWL_BASE_URL=https://api.firecrawl.dev/v1

# --- Embeddings -------------------------------------------------------------
# sentence-transformers model, downloaded and run locally. Multilingual:
# the corpus and the queries are a mix of French and English.
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
