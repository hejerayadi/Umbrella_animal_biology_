# Copy this file to .env inside Literature_Agent/ before running this agent locally.
AGENT_NAME=Literature_Agent
AGENT_MODE=local

# --- Azure OpenAI, one block per role ---------------------------------------
# The parts of this agent can run on different deployments, so settings are
# named per role. A single AZURE_OPENAI_* set cannot describe two resources:
# listing it twice in a .env raises nothing, the last line silently wins and
# the other resource is never reached.
#
# Lookup order for every setting, first hit wins:
#   AZURE_LITERATURE_<ROLE>_<FIELD>  -> this role only
#   AZURE_LITERATURE_<FIELD>         -> every role in this agent
#   AZURE_OPENAI_<FIELD>             -> the shared backend configuration
#
# So one agent-wide block is enough when every role uses the same deployment;
# add a role block only where it differs.
#
# All of this is optional: with nothing set the agent still starts and answers,
# and the router falls back to the keyword matcher in routing/router.py.
#
# ENDPOINT may be pasted with or without a trailing /openai/v1 - the client
# trims it, because the SDK appends /openai/deployments/... itself.
# API_VERSION must be recent enough for max_completion_tokens; on older
# versions such as 2024-06-01 a gpt-5 deployment returns empty content.

# Route classification in orchestrator/graph.py
AZURE_LITERATURE_ROUTER_ENDPOINT=
AZURE_LITERATURE_ROUTER_API_KEY=
AZURE_LITERATURE_ROUTER_API_VERSION=2024-12-01-preview
AZURE_LITERATURE_ROUTER_DEPLOYMENT=

# Scientific writing support (subagents/writing/)
AZURE_LITERATURE_WRITING_ENDPOINT=
AZURE_LITERATURE_WRITING_API_KEY=
AZURE_LITERATURE_WRITING_API_VERSION=2024-12-01-preview
AZURE_LITERATURE_WRITING_DEPLOYMENT=

# Knowledge discovery (subagents/discovery/)
AZURE_LITERATURE_DISCOVERY_ENDPOINT=
AZURE_LITERATURE_DISCOVERY_API_KEY=
AZURE_LITERATURE_DISCOVERY_API_VERSION=2024-12-01-preview
AZURE_LITERATURE_DISCOVERY_DEPLOYMENT=

# .env is git-ignored and must never be committed. This .env.example IS
# committed, so keep real secrets out of it - placeholders only.

# --- Writing knowledge base (Qdrant) ----------------------------------------
# Read by subagents/writing/kb/qdrant_setup.py, which loads THIS file's .env
# by absolute path. Without QDRANT_URL the three retrieval tools in
# scientific_writing.py degrade to "retrieval is currently unavailable" and the
# draft is still written - the KB only ever supplied style examples, never
# citable sources.
QDRANT_URL=
QDRANT_API_KEY=

# Only needed to re-run the ingestion scripts in subagents/writing/kb/
# (ingest_*.py). Retrieval itself uses Qdrant cloud inference and does not
# call Azure embeddings.
AZURE_EMBEDDING_DEPLOYMENT=
