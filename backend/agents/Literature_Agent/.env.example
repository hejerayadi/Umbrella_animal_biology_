# ============================================================================
# Literature Agent - the ONE .env for this agent and every subagent under it.
#
# Copy to .env inside Literature_Agent/ and fill it in. The .env is
# git-ignored; this .env.example IS committed, so keep real secrets out of it -
# placeholders only.
#
# There is deliberately a single settings file. The subagents used to keep
# their own .env next to their code, which is how the same Qdrant cluster
# ended up addressed with four different API keys and two conflicting
# AZURE_OPENAI_* sets: which credentials a subagent got depended on which file
# it loaded first. Every module now loads this path explicitly.
# ============================================================================

AGENT_NAME=Literature_Agent
AGENT_MODE=local

# --- Azure OpenAI, one block per role ---------------------------------------
# The parts of this agent can run on different deployments, so settings are
# named per role. A single AZURE_OPENAI_* set cannot describe two resources:
# listing it twice raises nothing, the last line silently wins and the other
# resource is never reached.
#
# Lookup order for every setting, first hit wins:
#   AZURE_LITERATURE_<ROLE>_<FIELD>  -> this role only
#   AZURE_LITERATURE_<FIELD>         -> every role in this agent
#   AZURE_OPENAI_<FIELD>             -> the shared fallback at the bottom
#
# So one agent-wide block is enough when every role uses the same deployment;
# add a role block only where it differs.
#
# All of this is optional: with nothing set the agent still starts and answers,
# and the router falls back to the keyword matcher in routing/router.py.
#
# ENDPOINT may be pasted with or without a trailing /openai/v1 - each client
# normalises it for the SDK it uses.
# API_VERSION must be recent enough for max_completion_tokens; on older
# versions such as 2024-06-01 a gpt-5 deployment returns empty content.

# Route classification in orchestrator/graph.py
AZURE_LITERATURE_ROUTER_ENDPOINT=
AZURE_LITERATURE_ROUTER_API_KEY=
AZURE_LITERATURE_ROUTER_API_VERSION=2024-12-01-preview
AZURE_LITERATURE_ROUTER_DEPLOYMENT=

# Scientific writing support (subagents/writing/)
AZURE_LITERATURE_WRITING_ENDPOINT=
AZURE_LITERATURE_WRITING_API_KEY=
AZURE_LITERATURE_WRITING_API_VERSION=2024-12-01-preview
AZURE_LITERATURE_WRITING_DEPLOYMENT=

# Knowledge discovery (subagents/discovery/, subagents/scientific_analysis/)
AZURE_LITERATURE_DISCOVERY_ENDPOINT=
AZURE_LITERATURE_DISCOVERY_API_KEY=
AZURE_LITERATURE_DISCOVERY_API_VERSION=2024-12-01-preview
AZURE_LITERATURE_DISCOVERY_DEPLOYMENT=

# Publication support (subagents/publication_support/), resolved by
# subagents/publication_support/azure_config.py.
#
# Use a plain chat deployment here, NOT a reasoning one: ranking/llm_reranker.py
# and ranking/query_interpreter.py send `temperature` and `max_tokens`, which a
# gpt-5-class deployment rejects. Without these the pipeline still retrieves and
# hybrid-ranks journals; only the LLM re-ranking step is skipped.
AZURE_LITERATURE_PUBLICATION_ENDPOINT=
AZURE_LITERATURE_PUBLICATION_API_KEY=
AZURE_LITERATURE_PUBLICATION_API_VERSION=2024-12-01-preview
AZURE_LITERATURE_PUBLICATION_DEPLOYMENT=

# Shared fallback, used by any role whose own block above is empty.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=

# --- Qdrant Cloud -----------------------------------------------------------
# One cluster, one key, shared by every collection this agent reads:
#   ghaya_*                     writing style KB (subagents/writing/kb/)
#   sci_*                       scientific analysis (subagents/scientific_analysis/)
#   journals                    publication support
#   lina_researchPaperArticles  retrieval cache (subagents/retrieval_knowledge/)
#
# Without QDRANT_URL the three retrieval tools in scientific_writing.py degrade
# to "retrieval is currently unavailable" and the draft is still written - the
# KB only ever supplied style examples, never citable sources.
QDRANT_URL=
QDRANT_API_KEY=

# Retrieval & Knowledge Processing. QDRANT_VECTOR_SIZE must match the embedding
# model's output dimension (384 for the MiniLM models below); changing it
# requires re-creating the collection.
QDRANT_COLLECTION=lina_researchPaperArticles
QDRANT_VECTOR_SIZE=384

# Publication support's journal collection, ingested from OpenAlex.
QDRANT_JOURNALS_COLLECTION=journals

# --- Embedding models -------------------------------------------------------
# Two keys on purpose, because two subsystems use different models.
#
# Bare EMBEDDING_MODEL is read ONLY by subagents/retrieval_knowledge/
# finalagenttt.py. Its corpus and queries are a mix of French and English, so
# the model is multilingual, and its Qdrant cache was built with it - swapping
# it silently poisons that cache, with no dimension error to warn you because
# both models are 384-dim.
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2

# The scientific analysis KB, read by subagents/scientific_analysis/config.py.
SCI_ANALYSIS_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
SCI_ANALYSIS_VECTOR_SIZE=384

# Only needed to re-run the ingestion scripts in subagents/writing/kb/
# (ingest_*.py). Retrieval itself uses Qdrant cloud inference and does not
# call Azure embeddings.
AZURE_EMBEDDING_DEPLOYMENT=

# --- Groq Cloud -------------------------------------------------------------
# Query generation, summarization and synthesis in the retrieval subagent.
# Without it Knowledge Discovery falls back to the labelled placeholder in
# subagents/discovery/sources.py.
GROQ_API_KEY=
GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions
GROQ_MODEL=openai/gpt-oss-20b

# --- Firecrawl --------------------------------------------------------------
# Web search and scraping for the retrieval subagent.
FIRECRAWL_API_KEY=
FIRECRAWL_BASE_URL=https://api.firecrawl.dev/v1
