# Evolution Agent — LLM configuration
# ─────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in ONE of the three options below.
# .env is git-ignored and must NEVER be committed.
#
# The agent tries backends in this order:
#   1. Azure OpenAI  ← use this for GPT-5 (project standard)
#   2. Groq          ← best free option for local dev
#   3. GitHub Models ← easiest free option, no sign-up required
#
# ─────────────────────────────────────────────────────────────────────
# OPTION 1 — Azure OpenAI with GPT-5  ✓ RECOMMENDED
#
# Where to get it:
#   → Ask your team lead for the Azure resource details, OR
#   → Azure Portal: https://portal.azure.com
#     1. Create an Azure OpenAI resource
#     2. Deploy a model named "gpt-5" in Azure AI Foundry
#     3. Copy the endpoint and key from "Keys and Endpoint"
#
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
AZURE_OPENAI_API_KEY=<your-azure-api-key>
AZURE_OPENAI_DEPLOYMENT=gpt-5
AZURE_OPENAI_API_VERSION=2024-08-01-preview


# ─────────────────────────────────────────────────────────────────────
# OPTION 2 — Groq (free, fast, no credit card)
#
# Where to get it:
#   → https://console.groq.com
#     1. Sign up (free)
#     2. Go to https://console.groq.com/keys
#     3. Create an API key — it starts with "gsk_"
#
# GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# GROQ_MODEL=llama-3.3-70b-versatile

# ─────────────────────────────────────────────────────────────────────
# OPTION 3 — GitHub Models (free, uses your GitHub account)
#
# Where to get it:
#   → https://github.com/settings/tokens
#     1. Click "Generate new token (classic)"
#     2. No scope required — just create it
#     3. Accept marketplace terms at: https://github.com/marketplace/models
#
# GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# GITHUB_MODEL=gpt-4o-mini

# ─────────────────────────────────────────────────────────────────────
# OPTIONAL — Qdrant (Sprint 3+ only, not needed for Sprint 2)
#
# QDRANT_URL=https://<cluster-id>.aws.cloud.qdrant.io:6333
# QDRANT_API_KEY=<your-qdrant-api-key>

# IQ-TREE service (CIPRES is retired; configure your replacement service)
# IQTREE_API_URL=http://localhost:8010

# --- External bioinformatics executables (optional) ---
# Absolute path, or a bare command name resolved on PATH.
# Leave empty to auto-detect: MAFFT_BINARY falls back to `mafft.bat` / `mafft`
# on PATH, IQTREE_BINARY to `iqtree3(.exe)` / `iqtree2(.exe)` / `iqtree`.
MAFFT_BINARY=
IQTREE_BINARY=

# ─────────────────────────────────────────────────────────────────────
# LANGSMITH TRACING  (Sprint 4, Task 3 — Agent Traceability)
#
# Enables end-to-end tracing of every request through the pipeline.
# All @traceable-decorated functions become no-op pass-throughs until
# LANGCHAIN_TRACING_V2=true, so leaving these unset has zero overhead.
#
# ── How to get your API key ──────────────────────────────────────────
#   1. Go to https://smith.langchain.com  (free tier available)
#   2. Sign up or log in
#   3. Click your avatar → Settings → API Keys → Create API Key
#   4. Copy the key (starts with "lsv2_pt_...")
#
# ── What gets traced ─────────────────────────────────────────────────
#   Span name                         | Decorated in
#   ─────────────────────────────────────────────────────────────────
#   "Evolution Agent request"         | orchestrator_adapter.py
#   "Planner (LLM #1)"                | planner.py
#   "Explainer (LLM #2)"              | explainer.py
#   "EvolutionOrchestrator graph"     | evolution_orchestrator.py
#     └── plan_node                   |   (LangGraph auto-traced)
#     └── species_resolver_node       |
#     └── dispatch_node               |
#     └── assemble_node               |
#     └── explain_node                |
#
# ── Optional: separate projects per environment ──────────────────────
#   LANGCHAIN_PROJECT=evolution-agent-dev    ← local development
#   LANGCHAIN_PROJECT=evolution-agent-staging
#   LANGCHAIN_PROJECT=evolution-agent        ← production / demo
#
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=lsv2_pt_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# LANGCHAIN_PROJECT=evolution-agent
# LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
