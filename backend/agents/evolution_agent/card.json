{
  "name": "Evolution Agent Orchestrator",
  "type": "orchestrator",
  "description": "Plans and coordinates evolutionary analysis tasks: molecular comparison of protein/gene sequences, phylogenetic tree construction, and divergence time estimation. Uses MAFFT alignment, ESMC protein embeddings, and TimeTree to infer evolutionary relationships between species.",
  "reports_to": [
    "Global Scientific Orchestrator"
  ],
  "may_need": [
    "Genome Agent",
    "Literature Agent"
  ],
  "managed_agents": [
    "Molecular Comparison Agent",
    "Phylogenetic Tree Agent",
    "Divergence Time Agent"
  ],
  "managed_services": [
    "GenBank",
    "UniProt",
    "MAFFT",
    "ESMC",
    "IQ-TREE",
    "TimeTree",
    "NCBI Taxonomy",
    "Qdrant (evolution_embeddings)"
  ],
  "capabilities": [
    "Planning",
    "Skill selection",
    "Species name normalization",
    "Sequential and parallel worker execution",
    "Conditional routing",
    "Result aggregation",
    "Cross-agent escalation (NEEDS_AGENT)"
  ],
  "input": {
    "instruction": "string",
    "context": "dict"
  },
  "output": {
    "evolution": "dict",
    "species_list": "list[string]",
    "newick_tree": "string",
    "model": "string",
    "similarity_scores": "list[dict]",
    "species_groups": "list[dict]",
    "alignment_url": "string | null",
    "tree_url": "string | null"
  }
}
