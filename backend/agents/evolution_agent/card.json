{
  "name": "Evolution Agent",
  "type": "worker",
  "description": "Compares molecular sequences to reconstruct phylogenetic relationships, and separately builds a functional similarity network from protein embeddings.",
  "reports_to": [
    "Umbrella Global Orchestrator"
  ],
  "may_need": [
    "Genome Agent",
    "Biodiversity Agent",
    "Literature Agent"
  ],
  "sub_agents": [
    "Molecular Comparison Sub-agent",
    "Phylogenetic Reconstruction Sub-agent"
  ],
  "managed_services": [
    "NCBI GenBank (provisional)",
    "UniProt (provisional)",
    "ESM2 embeddings (provisional)",
    "MAFFT / IQ-TREE (provisional)"
  ],
  "capabilities": [
    "Homology-based molecular comparison",
    "Multiple sequence alignment",
    "Maximum-likelihood phylogenetic reconstruction",
    "Branch support estimation",
    "Functional similarity network generation"
  ],
  "input": {
    "species_ids": "string[] | null",
    "sequences": "string[] | null"
  },
  "output": {
    "phylogenetic_tree": {
      "topology": "newick | null",
      "branch_support": "float[] | null"
    },
    "similarity_network": {
      "nodes": "string[] | null",
      "edges": "Edge[] | null"
    }
  },
  "result": "EvolutionAnalysisResult",
  "clarification_required": "boolean"
}
