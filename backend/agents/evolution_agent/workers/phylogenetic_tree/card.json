{
  "name": "Phylogenetic Tree Agent",
  "type": "worker",
  "description": "Builds a phylogenetic tree from aligned protein/gene sequences using neighbor-joining or IQ-TREE and returns it in Newick format with a rendered tree image.",
  "reports_to": [
    "Evolution Agent Orchestrator"
  ],
  "may_need": [],
  "managed_services": [
    "GenBank",
    "UniProt",
    "MAFFT",
    "IQ-TREE"
  ],
  "capabilities": [
    "Sequence retrieval",
    "Multiple sequence alignment",
    "Phylogenetic tree construction",
    "Newick serialization",
    "Tree visualization"
  ],
  "input": {
    "species_list": "list[string]",
    "reference_species": "string | null",
    "feature": "phylogenetic_tree"
  },
  "output": {
    "species_list": "list[string]",
    "newick_tree": "string",
    "tree_url": "string"
  }
}
