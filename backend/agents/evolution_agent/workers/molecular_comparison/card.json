{
  "name": "Molecular Comparison Agent",
  "type": "worker",
  "description": "Fetches protein/gene sequences from GenBank and UniProt, aligns them with MAFFT, computes ESMC embeddings, and returns pairwise similarity scores with a similarity network.",
  "reports_to": [
    "Evolution Agent Orchestrator"
  ],
  "may_need": [],
  "managed_services": [
    "GenBank",
    "UniProt",
    "MAFFT",
    "ESMC"
  ],
  "capabilities": [
    "Sequence retrieval",
    "Multiple sequence alignment",
    "Protein embedding",
    "Pairwise similarity scoring",
    "Similarity network construction"
  ],
  "input": {
    "species_list": "list[string]",
    "feature": "molecular_comparison"
  },
  "output": {
    "species_list": "list[string]",
    "similarity_scores": "list[dict]",
    "alignment_url": "string"
  }
}
