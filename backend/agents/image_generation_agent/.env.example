# Azure AI Foundry — FLUX.2-pro (BFL provider-specific API)
# Deploy FLUX.2-pro in Foundry, then copy the resource endpoint from Keys and Endpoint.
# Copy this file to .env and fill in your own values. Never commit the real .env.
AZURE_FLUX_ENDPOINT=https://<your-resource-name>.services.ai.azure.com/providers/blackforestlabs/v1/flux-2-pro
AZURE_FLUX_API_KEY=your-azure-flux-api-key

# Optional overrides
AZURE_FLUX_API_VERSION=preview
AZURE_FLUX_DEPLOYMENT=FLUX.2-pro
AZURE_FLUX_WIDTH=1024
AZURE_FLUX_HEIGHT=1024
AZURE_FLUX_OUTPUT_FORMAT=jpeg
AZURE_FLUX_TIMEOUT=300

# Fallback: if AZURE_FLUX_API_KEY is unset, flux_client.py reads AZURE_OPENAI_API_KEY
# AZURE_OPENAI_API_KEY=your-azure-openai-api-key
