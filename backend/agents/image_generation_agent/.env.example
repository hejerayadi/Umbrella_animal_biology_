# --- FLUX.2-pro on Azure AI Foundry (required) -------------------------------
# Without these two the agent still starts and still routes, but every
# generation returns FAILED with the message flux_client.py raises below.
#
# Deploy FLUX.2-pro in Azure AI Foundry, then copy the resource endpoint from
# "Keys and Endpoint". flux_client.py appends the BFL provider path
# (/providers/blackforestlabs/v1/flux-2-pro) itself, so paste the bare
# resource URL - appending it here as well is harmless but not needed.
# Example: https://<resource-name>.services.ai.azure.com
AZURE_FLUX_ENDPOINT=
AZURE_FLUX_API_KEY=

# Optional overrides; the values shown are the defaults baked into
# flux_client.py, so an empty file behaves identically to this one.
AZURE_FLUX_API_VERSION=preview
AZURE_FLUX_DEPLOYMENT=FLUX.2-pro
AZURE_FLUX_WIDTH=1024
AZURE_FLUX_HEIGHT=1024
# jpeg keeps a 1024x1024 render near ~440 KB of base64. png roughly triples
# that, and the whole data URI has to survive backend/image_store.py's 8 MB
# ceiling before the browser ever sees it.
AZURE_FLUX_OUTPUT_FORMAT=jpeg
# Seconds. FLUX takes tens of seconds per image; the orchestrator's own read
# timeout (AGENT_READ_TIMEOUT_SECONDS, default 600) has to stay above this.
AZURE_FLUX_TIMEOUT=300

# --- Scientific critic (optional) --------------------------------------------
# Only reached on protein/gene requests, where evidence_workflow.py gathers
# UniProt + PDB evidence and scientific_critic.py rules ACCEPT / REVISE /
# ABSTAIN on it. ABSTAIN stops the drawing.
#
# Leave these empty and the critic runs deterministically, from the UniProt and
# PDB results alone - which is a real verdict, not a disabled one. Filling them
# adds an Azure gpt-4.1-mini second opinion on top, and only ever makes the
# verdict stricter (see _strictest in scientific_critic.py).
#
# Species-only requests never touch any of this: no protein identifier means no
# evidence gathering and no critic.
AZURE_OPENAI_BASE_URL=
AZURE_OPENAI_API_KEY=
AZURE_CRITIC_DEPLOYMENT=gpt-4.1-mini
AZURE_CRITIC_API_VERSION=2024-10-21
AZURE_CRITIC_TIMEOUT=60

# --- Web search (optional) ---------------------------------------------------
# tools/web_search.py, via Serper (https://serper.dev). Consulted only when
# UniProt or PDB came back thin, to add context the critic and prompt can use.
# Unset, the search reports itself unavailable and the run continues - it is
# supplementary evidence, never a prerequisite.
SERPER_API_KEY=
