NVIDIA_NIM_API_KEY=nvapi-REPLACE-ME
# mistral-nemotron (and every plain-instruct model previously in this slot)
# came back 404/410 in a full probe_all_models.py sweep of this key as of
# Aug 2026 -- see workflows/llm/client.py's FALLBACK_MODELS comment for the
# full list of what's actually alive right now (5 of 46 probed, all
# hybrid-reasoning: 3x Nemotron-3, 2x GPT-OSS). Re-run that probe before
# reverting this default.
NIM_MODEL=nvidia/nemotron-3-nano-30b-a3b
NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NIM_TEMPERATURE=0.2

# Retry/backoff tuning for NIM 429s (workflows/llm/client.py). Defaults are
# conservative for a free-tier key that hits rate limits often; a paid key
# with a higher quota can lower these or leave them as-is (patience just
# costs latency, not correctness). NIM_MIN_CALL_INTERVAL_SECONDS is off (0)
# by default — set it (e.g. 3-5) to proactively space out NIM calls and
# avoid tripping the limit in the first place, at the cost of a flat latency
# tax on every call, on top of the reactive retry-with-backoff below.
NIM_MAX_RATE_LIMIT_RETRIES=5
NIM_RATE_LIMIT_RETRY_BASE_SECONDS=10
NIM_RATE_LIMIT_RETRY_MAX_SECONDS=60
NIM_MIN_CALL_INTERVAL_SECONDS=0

# Raw socket/connection timeouts (distinct from the 429/503 HTTP errors
# above) get their own short retry budget -- one slow/cold-starting request
# used to kill the whole gene/pathway/protein decision outright. A timeout
# that outlives this retry budget is also treated as advance-worthy for
# NIM_FALLBACK_MODELS above (see _is_advance_worthy_error in
# workflows/llm/client.py) -- same as a 404/410, since a model that keeps
# timing out is just as unusable right now.
NIM_MAX_TIMEOUT_RETRIES=2
NIM_TIMEOUT_RETRY_BASE_SECONDS=2

# Client transport timeout in seconds for a single NIM request (see get_llm
# in workflows/llm/client.py). langchain_nvidia_ai_endpoints defaults to
# 60s, which was fine for a plain-instruct model's near-instant reply but
# cuts off a hybrid-reasoning model mid chain-of-thought -- every model now
# in NIM_FALLBACK_MODELS is one of those. 180s gives the largest of them
# (nemotron-3-ultra-550b-a55b, gpt-oss-120b) realistic room to actually
# finish an NIM_MAX_TOKENS-sized completion.
NIM_REQUEST_TIMEOUT_SECONDS=180

# Generic 5xx from NIM's own gateway (observed as both '[500] Internal
# Server Error' and the opaque '[500] Unknown Error' / 'Inference
# connection error while making inference request') gets the same
# short-retry-then-advance treatment as a timeout above -- see
# _is_server_error in workflows/llm/client.py. Deliberately distinct from
# the 503 capacity handling above: a 500 means NIM's gateway itself failed
# to reach the model backend, which can be either transient or specific to
# whichever model is currently selected.
NIM_MAX_SERVER_ERROR_RETRIES=2
NIM_SERVER_ERROR_RETRY_BASE_SECONDS=2

# Reply budget per call. Bumped from 2048 to 8192: with no plain-instruct
# model alive on this key at all (see NIM_MODEL above), every model in
# NIM_FALLBACK_MODELS is a hybrid-reasoning model that can produce thousands
# of tokens of visible chain-of-thought -- nemotron-3-super-120b-a12b has
# been observed doing this fully despite the /no_think preamble -- before
# ever reaching its JSON final answer. Token budget (together with
# NIM_REQUEST_TIMEOUT_SECONDS above) is now the primary defense against
# truncated/non-JSON answers, not model ordering or the preamble alone.
NIM_MAX_TOKENS=8192
QDRANT_URL=https://<your-cluster-id>.cloud.qdrant.io:6333
QDRANT_API_KEY=<your-api-key>

# Neo4j knowledge graph (kb/neo4j_store.py) — Literature Support's
# trait->gene relationship write. For local/docker-compose use, the `neo4j`
# service below exposes bolt on 7687 with these defaults; point NEO4J_URI at
# a managed instance (e.g. AuraDB) in other environments.
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me-in-real-envs

# A2A endpoint for the external Literature Agent (owned/deployed separately —
# see kb/sources/literature_agent_client.py). Its /execute contract is the
# same AgentRequest/AgentResult envelope every worker agent here speaks.
LITERATURE_AGENT_URL=http://literature-agent:8000/execute

# KEGG REST API (kb/sources/kegg_client.py) is free for academic,
# non-commercial use only (https://www.kegg.jp/kegg/legal.html). Leave both
# unset/false for academic use. If this deployment is commercial, set
# KEGG_COMMERCIAL_USE=true AND KEGG_COMMERCIAL_USE_LICENSED=true (the latter
# only once you actually hold a paid KEGG FTP/API license) — the Pathways
# agent will refuse to call KEGG otherwise.
KEGG_COMMERCIAL_USE=false
KEGG_COMMERCIAL_USE_LICENSED=false

# LangSmith tracing (Sprint 4 Part C). Leave LANGCHAIN_TRACING_V2 unset/false
# to run with tracing off (no other code path here depends on it). If you're
# on the same LangSmith org as the Genome Agent subteam, check with them
# before minting a second API key -- reuse theirs if this is a shared sprint.
# Use a project name specific to this agent so traces don't mix with the
# Genome Agent's, e.g. the default below.
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=<your-langsmith-api-key>
LANGCHAIN_PROJECT=trait-discovery-agent-sprint4
