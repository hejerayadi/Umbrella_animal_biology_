NVIDIA_NIM_API_KEY=nvapi-REPLACE-ME
NIM_MODEL=nvidia/nemotron-3-super-120b-a12b
NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NIM_TEMPERATURE=0.2
QDRANT_URL=https://<your-cluster-id>.cloud.qdrant.io:6333
QDRANT_API_KEY=<your-api-key>

# A2A endpoint for the external Literature Agent (owned/deployed separately —
# see kb/sources/literature_agent_client.py). Its /execute contract is the
# same AgentRequest/AgentResult envelope every worker agent here speaks.
LITERATURE_AGENT_URL=http://literature-agent:8000/execute
