# Application
APP_ENV=local
APP_VERSION=1.1.0
APP_HOST=127.0.0.1
# The standalone scientific service (scripts/serve.py). Not 8000: that port
# belongs to the Global Orchestrator's API, and not 8008 either, which is
# where this agent answers the orchestrator over /execute.
APP_PORT=8010
APP_RELOAD=true

# Structured logging: pretty for local TTY output, json for deployments; text aliases pretty
LOG_LEVEL=INFO
LOG_FORMAT=pretty

# Persistence
# PostgreSQL is out of scope for this sprint. Leave PERSISTENCE_ENABLED=false;
# when it is enabled, DATABASE_URL is used and Alembic owns the schema.
PERSISTENCE_ENABLED=false
DATABASE_URL=sqlite:///./protein_agent.db

# Qdrant (managed cluster - no local container)
QDRANT_URL=https://<cluster-id>.<region>.cloud.qdrant.io:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=protein_knowledge
RETRIEVAL_TOP_K=5
INTERNAL_INGESTION_API_KEY=change-me

# Embeddings
EMBEDDING_PROVIDER=bge-m3
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIMENSIONS=1024

# Azure LLM (set LLM_PROVIDER=azure to enable explanation and critic generation)
LLM_PROVIDER=disabled
AZURE_OPENAI_BASE_URL=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_KEY=
AZURE_AI_API_VERSION=2024-10-21
AZURE_FOUNDRY_PROJECT_ENDPOINT=

# Optional: USD per 1,000 tokens for the deployed model. Token counts on every
# response come from Azure itself either way; leave both unset to see tokens
# and latency without an estimated cost - pricing depends on region, contract
# and model version, none of which the API exposes, so it is never guessed.
AZURE_INPUT_PRICE_PER_1K_USD=
AZURE_OUTPUT_PRICE_PER_1K_USD=

# Biological sources
UNIPROT_BASE_URL=https://rest.uniprot.org
RCSB_SEARCH_BASE_URL=https://search.rcsb.org/rcsbsearch/v2
RCSB_DATA_BASE_URL=https://data.rcsb.org
RCSB_FILES_BASE_URL=https://files.rcsb.org
ALPHAFOLD_BASE_URL=https://alphafold.ebi.ac.uk/api
INTERPRO_BASE_URL=https://www.ebi.ac.uk/interpro/api
SIFTS_BASE_URL=https://www.ebi.ac.uk/pdbe/api

# HTTP behaviour
HTTP_TIMEOUT_SECONDS=15
HTTP_MAX_RETRIES=2
MAX_STRUCTURE_CANDIDATES=10
