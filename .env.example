# Copie ce fichier en ".env" et remplis tes vraies valeurs
# Cree un compte gratuit sur https://cloud.qdrant.io pour obtenir URL + API key

QDRANT_URL=https://your-cluster-url.qdrant.io
QDRANT_API_KEY=your-api-key-here

# Modele d'embedding (dimension 384, rapide, bon pour demarrer)
# Pour du biomedical plus pousse : pritamdeka/S-BioBert-snli-multinli-stsb (dimension 768)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
